{
  "expo": {
    "name": "AgentCard",
    "slug": "agentcard",
    "scheme": "agentcard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agentcard.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.agentcard.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-camera"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://5ftn4385ci.execute-api.us-west-2.amazonaws.com",
      "cognitoUserPoolId": "us-west-2_kc7vTAPk3",
      "cognitoClientId": "dpg44jq8igglc0cjqmks7e1ec",
      "assetsBucketUrl": "https://agentcard-dev-assetsbucketbucket-omhhnhte.s3.us-west-2.amazonaws.com"
    }
  }
}
